{
  "name": "@dschz/tsconfig",
  "version": "0.0.0",
  "description": "Shared TypeScript configurations for @dschz packages",
  "homepage": "https://github.com/dsnchz/tsconfig#readme",
  "bugs": {
    "url": "https://github.com/dsnchz/tsconfig/issues"
  },
  "license": "MIT",
  "author": "Daniel Sanchez <dsanc89@icloud.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/dsnchz/tsconfig.git"
  },
  "files": [
    "base.json",
    "solid.json",
    "react.json"
  ],
  "type": "module",
  "exports": {
    "./base": "./base.json",
    "./solid": "./solid.json",
    "./react": "./react.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "pkg:changeset": "changeset",
    "pkg:version": "changeset version",
    "postpkg:version": "bun -e \"import {readFileSync,writeFileSync} from 'fs'; const jsr=JSON.parse(readFileSync('jsr.json','utf8')); jsr.version=JSON.parse(readFileSync('package.json','utf8')).version; writeFileSync('jsr.json',JSON.stringify(jsr,null,2)+'\\n');\"",
    "pkg:publish": "changeset publish && jsr publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "oxfmt": "^0.41.0",
    "typescript": "^6.0.2"
  },
  "packageManager": "bun@1.3.11"
}
